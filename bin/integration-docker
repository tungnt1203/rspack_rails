#!/usr/bin/env bash
# End-to-end check that a new app deploys with Docker (as Kamal does):
# `rails new --devcontainer -m template.rb`, then `docker build` (which runs
# assets:precompile, and so rspack) and a request to the running container.
# Also checks the devcontainer and bin/setup edits.
#
#   bin/integration-docker
#   bin/integration-docker "~> 8.1.0"
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REQUIREMENT="${1:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"
IMAGE="rspack-rails-docker-test"
PORT="${PORT:-3180}"

step() { printf '\n==> %s\n' "$*"; }
fail() { echo "FAIL: $*"; exit 1; }

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

step "rails new --devcontainer -m template.rb with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
RSPACK_RAILS_PATH="$GEM_ROOT" "${rails_cmd[@]}" new app --quiet --skip-javascript \
  --devcontainer --skip-test --skip-system-test --skip-active-record --skip-ci --skip-rubocop --skip-brakeman \
  -m "$GEM_ROOT/template.rb"
cd app

step "Checking the Dockerfile, devcontainer and bin/setup"
grep -q 'node-build' Dockerfile || fail "Dockerfile does not install Node.js"
grep -q 'RUN npm ci' Dockerfile || fail "Dockerfile does not install node modules"
grep -q 'RUN rm -rf node_modules' Dockerfile || fail "Dockerfile keeps node_modules"
grep -q 'features/node' .devcontainer/devcontainer.json || fail "devcontainer has no Node.js feature"
grep -Eq '"forwardPorts": \[[^]]*\b3036\]' .devcontainer/devcontainer.json || fail "devcontainer does not forward 3036"
grep -q 'system!("npm install")' bin/setup || fail "bin/setup does not install node modules"
doctor=$(bin/rails rspack:doctor || true)
grep -q '✓ Dockerfile' <<<"$doctor" || fail "doctor: $doctor"
grep -q '✓ Dev container' <<<"$doctor" || fail "doctor: $doctor"

step "Putting this checkout's gem in the build context (a path outside it is not copied into the image)"
# vendor/rspack_rails, listed as the gemspec lists its files. The Dockerfile copies
# `vendor/*`, which would flatten a directory, so it copies vendor as it is.
mkdir -p vendor/rspack_rails
(cd "$GEM_ROOT" && cp -R lib sig README.md CHANGELOG.md LICENSE.txt rspack_rails.gemspec "$WORK_DIR/app/vendor/rspack_rails/")
sed -i.bak 's|^gem "rspack_rails", path: .*|gem "rspack_rails", path: "vendor/rspack_rails"|' Gemfile && rm Gemfile.bak
sed -i.bak 's|^COPY vendor/\* ./vendor/$|COPY vendor ./vendor|' Dockerfile && rm Dockerfile.bak
grep -q '^COPY vendor ./vendor$' Dockerfile || fail "could not change the Dockerfile to copy vendor/"
bundle lock --add-platform x86_64-linux aarch64-linux >/dev/null
bundle install --quiet

step "docker build"
docker build -t "$IMAGE" .

step "docker run"
docker rm -f "$IMAGE" >/dev/null 2>&1 || true
docker run -d --name "$IMAGE" -p "$PORT:80" -e RAILS_MASTER_KEY="$(cat config/master.key)" "$IMAGE" >/dev/null
trap 'docker rm -f "$IMAGE" "$IMAGE-v2" "$IMAGE-assets" >/dev/null 2>&1 || true' EXIT
for _ in $(seq 1 60); do curl -sf -o /dev/null "http://localhost:$PORT/up" && break; sleep 1; done
curl -sf -o /dev/null "http://localhost:$PORT/up" || { docker logs "$IMAGE" | tail -20; fail "/up did not respond"; }
asset=$(docker exec "$IMAGE" ls public/rspack | grep -E '^application-[0-9a-f]+\.js$') || fail "application.js not precompiled"
curl -sf "http://localhost:$PORT/rspack/$asset" | grep -q 'Hello from rspack_rails' || fail "/rspack/$asset is not the rspack bundle"
docker exec "$IMAGE" sh -c 'test ! -d node_modules' || fail "node_modules shipped in the image"

step "Rolling deploy, as Kamal's asset bridging does it (simulated)"
# With `asset_path: /rails/public/rspack`, Kamal copies that directory out of each
# image (extract_assets) and gives the new container a volume with the new files
# plus the old ones, never overwriting (`cp -rnT`, sync_asset_volumes). A page
# loaded from the old version asks the new container for its old chunks.
v1="$WORK_DIR/assets-v1" v2="$WORK_DIR/assets-v2" volume="$WORK_DIR/assets-volume"
rm -rf "$v1" "$v2" "$volume"; mkdir -p "$v1" "$v2" "$volume"
docker cp "$IMAGE:/rails/public/rspack/." "$v1"
old_js=$(ls "$v1" | grep -E '^application-[0-9a-f]+\.js$') || fail "no application.js in the first image"
echo 'window.rollingDeploy = true' >> app/javascript/application.js
docker build -q -t "$IMAGE-v2" . >/dev/null
docker rm -f "$IMAGE-assets" >/dev/null 2>&1 || true
docker create --name "$IMAGE-assets" "$IMAGE-v2" >/dev/null
docker cp "$IMAGE-assets:/rails/public/rspack/." "$v2"
docker rm "$IMAGE-assets" >/dev/null
new_js=$(ls "$v2" | grep -E '^application-[0-9a-f]+\.js$') || fail "no application.js in the second image"
[ "$new_js" != "$old_js" ] || fail "a changed source gave the same file name"
ls "$v2" | grep -q "^$old_js$" && fail "the second image has the first image's files"
cp -Rn "$v2/." "$volume/" # new first: its manifest wins, as with cp -rnT
cp -Rn "$v1/." "$volume/" || true # BSD cp exits 1 for the files it skips; Kamal ignores that too
docker run -d --name "$IMAGE-v2" -p "$((PORT + 1)):80" -e RAILS_MASTER_KEY="$(cat config/master.key)" \
  -v "$volume:/rails/public/rspack" "$IMAGE-v2" >/dev/null
for _ in $(seq 1 60); do curl -sf -o /dev/null "http://localhost:$((PORT + 1))/up" && break; sleep 1; done
curl -sf -o /dev/null "http://localhost:$((PORT + 1))/up" || { docker logs "$IMAGE-v2" | tail -20; fail "the new version did not start"; }
for file in "$old_js" "$new_js"; do
  [ "$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$((PORT + 1))/rspack/$file")" = 200 ] ||
    fail "the new container does not serve /rspack/$file"
done
page=$(docker exec "$IMAGE-v2" bin/rails runner 'puts ApplicationController.render(inline: %(<%= rspack_javascript_tag "application" %>))')
grep -q "$new_js" <<<"$page" || fail "the new version does not link its own build: $page"
grep -q "$old_js" <<<"$page" && fail "the new version links the old build: $page"

step "OK"
