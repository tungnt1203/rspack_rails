#!/usr/bin/env bash
# End-to-end check of template.rb: `rails new -m template.rb`, then build,
# doctor and production precompile.
#
#   bin/integration-template skip-js          # --skip-javascript
#   bin/integration-template no-pipeline      # --skip-javascript --skip-asset-pipeline: no Propshaft or Sprockets
#   bin/integration-template importmap        # default rails new (importmap), migrated
#   bin/integration-template importmap "~> 8.1.0"
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODE="${1:?usage: bin/integration-template skip-js|no-pipeline|importmap [rails requirement]}"
REQUIREMENT="${2:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"

step() { printf '\n==> %s\n' "$*"; }
fail() { echo "FAIL: $*"; exit 1; }

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

skip=(--skip-test --skip-system-test --skip-active-record --skip-docker --skip-ci --skip-rubocop --skip-brakeman)
case "$MODE" in
  skip-js) flags=(--skip-javascript) ;;
  no-pipeline) flags=(--skip-javascript --skip-asset-pipeline) ;;
  importmap) flags=() ;; # the default: importmap-rails, migrated
  *) fail "unknown mode $MODE" ;;
esac

step "rails new -m template.rb ($MODE) with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
RSPACK_RAILS_PATH="$GEM_ROOT" "${rails_cmd[@]}" new app --quiet ${flags[@]+"${flags[@]}"} "${skip[@]}" -m "$GEM_ROOT/template.rb"
cd app

step "Checking the app"
grep -q 'gem "rspack_rails"' Gemfile || fail "rspack_rails not in Gemfile"
[ -f rspack.config.mjs ] || fail "rspack.config.mjs missing"
[ ! -e config/rspack ] || fail "config/rspack exists: the config is one file now"
[ -f public/rspack/.rspack-manifest.json ] || fail "template did not build"
grep -q 'rspack_javascript_tag "application"' app/views/layouts/application.html.erb || fail "layout tag missing"

if [ "$MODE" = no-pipeline ]; then
  ! grep -Eq '^    (propshaft|sprockets-rails) ' Gemfile.lock || fail "the app has an asset pipeline"
fi

if [ "$MODE" = importmap ]; then
  [ ! -f config/importmap.rb ] || fail "config/importmap.rb not removed"
  ! grep -q importmap-rails Gemfile || fail "importmap-rails still in Gemfile"
  grep -q 'webpackContext' app/javascript/controllers/index.js || fail "Stimulus controllers not registered through Rspack"
  ! grep -q 'stimulus-loading' app/javascript/controllers/index.js || fail "controllers/index.js still uses stimulus-loading"
fi

step "rspack:doctor"
bin/rails rspack:doctor

step "assets:precompile (production)"
RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bin/rails assets:precompile
ls public/rspack | grep -Eq '^application-[0-9a-f]+\.js$' || fail "application.js not precompiled"
[ "$MODE" != no-pipeline ] || [ ! -e public/assets ] || fail "an asset pipeline wrote public/assets"

step "A page links the build, and Rails serves it"
cat > tmp/page_check.rb <<'RUBY'
html = ApplicationController.render(inline: %(<%= rspack_javascript_tag "application", integrity: true %>), assigns: {})
abort "no script tag: #{html}" unless html.match?(%r{src="/rspack/application-[0-9a-f]+\.js"})
src = html[%r{src="([^"]+)"}, 1]
response = Rack::MockRequest.new(Rails.application).get(src, "HTTP_HOST" => "localhost", "HTTPS" => "on")
abort "#{src}: #{response.status}" unless response.status == 200 && response.headers["cache-control"].include?("immutable")
RUBY
RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bin/rails runner tmp/page_check.rb

step "OK"
