#!/usr/bin/env bash
# End-to-end check: generate a new Rails app, install this gem from the
# working tree and run every installer, a build, the doctor and a
# production precompile.
#
#   bin/integration            # uses the default `rails` on PATH
#   bin/integration "~> 7.2.0" # installs/uses a matching Rails version
#   RSPACK_VERSION=2.0 bin/integration  # pins @rspack/* to ~2.0.0 (the oldest supported)
#   RSPACK_VERSION=3.0.0-beta.1 RSPACK_DEV_SERVER_VERSION=3.0.0-beta.0 bin/integration  # exact versions
#   PACKAGE_MANAGER=yarn bin/integration   # or bun; default npm. Yarn is Yarn 1
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REQUIREMENT="${1:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"

PACKAGE_MANAGER="${PACKAGE_MANAGER:-npm}"

step() { printf '\n==> %s\n' "$*"; }
assert_file() { [ -f "$1" ] || { echo "Expected file $1"; exit 1; }; }
# A file name rspack fingerprinted, as .rspack-manifest.json lists it:
#   built application js   ->  public/rspack/application-1a2b3c4d.js
built() {
  ruby -rjson -e 'file = JSON.parse(File.read("public/rspack/.rspack-manifest.json")).dig("entries", ARGV[0], ARGV[1])&.first
                  abort "no #{ARGV[1]} for #{ARGV[0]} in the manifest" unless file
                  puts "public/rspack/#{file}"' "$1" "$2"
}
assert_match() { grep -Eq "$2" <<<"$1" || { echo "Expected output to match $2, got:"; echo "$1"; exit 1; }; }

# dev dependency install and script running, for the package manager under test.
add_dev() {
  case "$PACKAGE_MANAGER" in
    yarn) yarn add --dev "$@" ;;
    bun) bun add --dev "$@" ;;
    npm) npm install --save-dev "$@" ;;
  esac
}
run_script() { "$PACKAGE_MANAGER" run "$@"; }

# A lockfile before rspack:install, so the installer detects this package manager
# instead of defaulting to npm. Yarn 1: the gem's frozen install is `yarn install
# --frozen-lockfile`, which Yarn 2+ does not support.
use_package_manager() {
  case "$PACKAGE_MANAGER" in
    npm) return ;;
    yarn | bun) ;;
    *) echo "Unknown PACKAGE_MANAGER: $PACKAGE_MANAGER (npm, yarn or bun)"; exit 1 ;;
  esac
  step "Using $PACKAGE_MANAGER"
  if [ "$PACKAGE_MANAGER" = yarn ]; then
    # Node 22 ships Corepack, which provides Yarn 1. Node 25+ does not, so a
    # Yarn 1 already on PATH is used as it is.
    if command -v corepack >/dev/null; then
      export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
      corepack enable
      corepack prepare yarn@1.22.22 --activate
    fi
    command -v yarn >/dev/null || { echo "Yarn 1 is not installed"; exit 1; }
    [ "$(yarn --version | cut -d. -f1)" = 1 ] ||
      { echo "Need Yarn 1 (found $(yarn --version)): the gem's frozen install uses --frozen-lockfile"; exit 1; }
  fi
  command -v "$PACKAGE_MANAGER" >/dev/null || { echo "$PACKAGE_MANAGER is not installed"; exit 1; }
  cp "$GEM_ROOT/lib/install/package.json" package.json
  # `bun install` deletes the lockfile when package.json has no dependencies,
  # and the installer would then fall back to npm. An empty file is enough:
  # detection only checks that it exists, and `bun add` rewrites it.
  if [ "$PACKAGE_MANAGER" = bun ]; then
    touch bun.lock
  else
    "$PACKAGE_MANAGER" install
  fi
}

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

step "Generating app with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
"${rails_cmd[@]}" new app --quiet --skip-javascript --skip-bundle --skip-git --skip-test --skip-system-test \
  --skip-active-record --skip-docker --skip-ci --skip-rubocop --skip-brakeman
cd app
echo "gem \"rspack_rails\", path: \"$GEM_ROOT\"" >> Gemfile
bundle install --quiet

use_package_manager

step "rspack:install"
bin/rails rspack:install
case "$PACKAGE_MANAGER" in
  yarn) assert_file yarn.lock; assert_match "$(cat Procfile.dev)" '^js: yarn run dev$' ;;
  bun) assert_file bun.lock; assert_match "$(cat Procfile.dev)" '^js: bun run dev$' ;;
esac
assert_file rspack.config.mjs
[ ! -e config/rspack ] || { echo "config/rspack exists: the config is one file now"; exit 1; }
# npm saves "^2.3.2"; Yarn 1 keeps the range it was given, "^2".
node -p 'require("./package.json").devDependencies["@rspack/core"]' | grep -Eq '^\^2($|\.)' ||
  { echo "@rspack/core is not pinned to ^2"; exit 1; }
if [ -n "${RSPACK_VERSION:-}" ]; then
  # "2.0" means ~2.0.0; anything else (3.0.0-beta.1, beta) is passed to npm as is.
  case "$RSPACK_VERSION" in
    *.*.* | *[!0-9.]*) spec="$RSPACK_VERSION" ;;
    *) spec="~${RSPACK_VERSION}.0" ;;
  esac
  step "Installing @rspack/core and @rspack/cli $spec, @rspack/dev-server ${RSPACK_DEV_SERVER_VERSION:-$spec}"
  add_dev "@rspack/core@$spec" "@rspack/cli@$spec" "@rspack/dev-server@${RSPACK_DEV_SERVER_VERSION:-$spec}"
  installed=$(node -p 'require("@rspack/core/package.json").version')
  echo "Using @rspack/core $installed"
  case "$spec" in "~"*) [[ "$installed" == "$RSPACK_VERSION".* ]] || { echo "@rspack/core is not ${RSPACK_VERSION}.x"; exit 1; } ;; esac
fi
grep -q '.rspack-manifest.json' rspack.config.mjs || { echo "rspack.config.mjs does not write the manifest"; exit 1; }

step "Adding CSS with images and a font"
mkdir -p app/javascript/images app/javascript/fonts
# A >8 KB image is emitted as a file, a tiny one is inlined as a data URI.
head -c 20000 /dev/urandom > app/javascript/images/hero.png
printf '<svg xmlns="http://www.w3.org/2000/svg"/>' > app/javascript/images/dot.svg
head -c 12000 /dev/urandom > app/javascript/fonts/brand.woff2
cat > app/javascript/application.css <<'CSS'
@font-face { font-family: Brand; src: url("./fonts/brand.woff2") format("woff2"); }
body { color: rebeccapurple; font-family: Brand; background: url("./images/hero.png"); }
.dot { background: url("./images/dot.svg"); }
/* Left for Rails, not bundled: a file in public/ and one in app/assets/images. */
.public-icon { background: url("/icon.png"); }
.pipeline-logo { background: url("/logo.svg#mark"); }
CSS
mkdir -p app/assets/images
printf '<svg xmlns="http://www.w3.org/2000/svg"><circle r="1"/></svg>' > app/assets/images/logo.svg
echo 'import "./application.css"' >> app/javascript/application.js
echo 'import heroUrl from "./images/hero.png"; window.heroUrl = heroUrl' >> app/javascript/application.js
echo 'export default "lazy-chunk"' > app/javascript/lazy.js
printf 'self.onmessage = (e) => self.postMessage(e.data * 2)\n' > app/javascript/worker.js
echo 'window.rspackWorker = new Worker(new URL("./worker.js", import.meta.url))' >> app/javascript/application.js
echo 'import("./lazy").then((m) => console.log(m.default))' >> app/javascript/application.js
step "Adding an admin entry point"
mkdir -p app/javascript/entrypoints
cat > app/javascript/entrypoints/admin.ts <<'TS'
import { suffix } from "@/lib/suffix" // a tsconfig "paths" alias
import { subpath } from "#/lib/subpath" // package.json "imports"

const area: string = "admin-entry"
const settings: { level?: number } = JSON.parse("{}")
console.log(area, suffix, subpath, settings?.level ?? 0)
TS
printf '@media print { .no-print { display: none; } }\n' > app/javascript/entrypoints/print.css
mkdir -p app/javascript/lib
echo 'export const suffix: string = "via-ts-alias"' > app/javascript/lib/suffix.ts
echo 'export const subpath: string = "via-subpath-import"' > app/javascript/lib/subpath.ts
echo 'export default "js-subpath-import"' > app/javascript/lib/plain.js
echo 'import plain from "#/lib/plain"; window.plain = plain' >> app/javascript/application.js
grep -q '"#/\*": "./app/javascript/\*"' package.json || { echo "package.json has no #/* imports"; exit 1; }
# "paths" aliases in tsconfig.json are resolved by rspack.
cat > tsconfig.json <<'JSON'
{ "compilerOptions": { "baseUrl": ".", "paths": { "@/*": ["./app/javascript/*"], "#/*": ["./app/javascript/*"] } } }
JSON

step "rspack:build"
bin/rails rspack:build
assert_file public/rspack/.rspack-manifest.json
assert_match "$(built application js)" 'public/rspack/application-[0-9a-f]+\.js$'
assert_match "$(built application css)" 'public/rspack/application-[0-9a-f]+\.css$'
assert_file "$(built application js)"
assert_file "$(built application css)"
assert_file "$(built admin js)"
assert_file "$(built application js).map"
[ -e app/assets/builds/application.js ] && { echo "built into app/assets/builds"; exit 1; }
ls public/rspack | grep -Eq '^hero-[0-9a-f]+\.png$' || { echo "hero image not emitted"; exit 1; }
# hero.png is in app/javascript/images (for views) and imported by CSS and JS: one file, not two.
[ "$(ls public/rspack | grep -cE '^hero-[0-9a-f]+\.png$')" = 1 ] || { echo "hero.png emitted twice"; exit 1; }
ruby -rjson -e 'a = JSON.parse(File.read("public/rspack/.rspack-manifest.json"))["assets"]
  abort "manifest assets: #{a}" unless a["hero.png"]&.match?(/\Ahero-[0-9a-f]+\.png\z/) && File.exist?("public/rspack/#{a["hero.png"]}")'
grep -q 'data:image/svg' "$(built application css)" || { echo "small image not inlined"; exit 1; }
grep -Eq 'url\("?/icon\.png"?\)' "$(built application css)" || { echo "url(\"/icon.png\") not kept as written"; exit 1; }
grep -Eq 'url\("?/logo\.svg#mark"?\)' "$(built application css)" || { echo "url(\"/logo.svg\") not kept"; exit 1; }
[ -d node_modules/.cache/rspack ] || { echo "persistent cache missing"; exit 1; }
assert_match "$(built print css)" 'public/rspack/print-[0-9a-f]+\.css$'
assert_file "$(built print css)"
ruby -rjson -e 'e = JSON.parse(File.read("public/rspack/.rspack-manifest.json"))["entries"]
  abort "manifest: #{e}" unless e["print"]["js"] == [] && e["print"]["stylesheetOnly"] == true &&
                                e["print"]["css"].one? { |f| f.match?(/\Aprint-[0-9a-f]+\.css\z/) } &&
                                e["application"]["js"].one? { |f| f.match?(/\Aapplication-[0-9a-f]+\.js\z/) }'
ls public/rspack | grep -Eq '^print-[0-9a-f]+\.js$' && { echo "stylesheet-only entry emitted a script"; exit 1; }
grep -q 'via-ts-alias' "$(built admin js)" || { echo "tsconfig paths alias not resolved"; exit 1; }
grep -q 'via-subpath-import' "$(built admin js)" || { echo "#/ import not resolved in TypeScript"; exit 1; }
grep -q 'js-subpath-import' "$(built application js)" || { echo "#/ import not resolved in JavaScript"; exit 1; }
find public/rspack -name '*hot-update*' | grep -q . && { echo "hot-update files in the build"; exit 1; }


step "Browser targets"
# Default target (Baseline widely available) keeps ?? ; a .browserslistrc for old browsers lowers it.
grep -q '??' "$(built admin js)" || { echo "?? lowered without a browserslist config"; exit 1; }
echo "chrome 70" > .browserslistrc
NODE_ENV=production node_modules/.bin/rspack build > /dev/null
grep -q '??' "$(built admin js)" && { echo ".browserslistrc not applied"; exit 1; }
rm .browserslistrc
bin/rails rspack:build

step "rspack serve (lazy compilation goes through Rails)"
node_modules/.bin/rspack serve > tmp/rspack-serve.log 2>&1 & # not npx: $! must be rspack itself
serve_pid=$!
for _ in $(seq 1 60); do curl -s -o /dev/null http://localhost:3036/application.js && break; sleep 0.5; done
# rspack:build ran first: the dev server must not reuse its cached modules,
# compiled without HMR (import.meta.webpackHot -> false).
# The page's origin forwards it: Rails proxies POST /rspack/_rspack/lazy/trigger to the dev server.
lazy=$(bin/rails runner '
  response = Rack::MockRequest.new(Rails.application).post("/rspack/_rspack/lazy/trigger",
    "HTTP_HOST" => "localhost", "CONTENT_TYPE" => "text/plain", input: "")
  puts response.status' 2>&1) || { kill $serve_pid; echo "$lazy"; exit 1; }
# Rails serves the dev server's files same-origin under /rspack/ (needed for Web Workers).
proxied=$(bin/rails runner '
  response = Rack::MockRequest.new(Rails.application).get("/rspack/application.js", "HTTP_HOST" => "localhost")
  puts response.status, response.body.include?("worker")' 2>&1) || { kill $serve_pid; echo "$proxied"; exit 1; }
assert_match "$proxied" '^200$'
# One shared runtime per page, and a stylesheet-only entry carries its hot update script.
tags=$(bin/rails runner 'puts ApplicationController.render(inline: %(<%= rspack_javascript_tag "application", "admin" %><%= rspack_stylesheet_tag "print" %>))' 2>&1) ||
  { kill $serve_pid; echo "$tags"; exit 1; }
[ "$(grep -o '/rspack/runtime.js' <<<"$tags" | wc -l | tr -d ' ')" = 1 ] || { kill $serve_pid; echo "runtime.js not linked once: $tags"; exit 1; }
assert_match "$tags" 'src="/rspack/print.js"'
# An image of app/javascript/images, for views, comes from the dev server too.
image_path=$(bin/rails runner 'puts ApplicationController.render(inline: %(<%= rspack_asset_path "dot.svg" %>))' 2>&1) ||
  { kill $serve_pid; echo "$image_path"; exit 1; }
image_path=$(grep -oE '/rspack/dot-[0-9a-f]+\.svg' <<<"$image_path" || { kill $serve_pid; echo "no image path: $image_path"; exit 1; })
[ "$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:3036${image_path#/rspack}")" = 200 ] ||
  { kill $serve_pid; echo "dev server does not serve $image_path"; exit 1; }
dev_sri=$(bin/rails runner 'puts ApplicationController.renderer.new(https: true).render(inline: %(<%= rspack_javascript_tag "application", integrity: true %>))' 2>&1) ||
  { kill $serve_pid; echo "$dev_sri"; exit 1; }
grep -q 'integrity' <<<"$dev_sri" && { kill $serve_pid; echo "integrity under rspack serve: $dev_sri"; exit 1; }
# The dev server keeps its files in memory; only its manifest, which the helpers read, goes to disk.
assert_file public/rspack/.rspack-dev-manifest.json
grep -q 'runtime.js' public/rspack/.rspack-dev-manifest.json || { kill $serve_pid; echo "dev manifest lists no runtime"; exit 1; }
[ -e public/rspack/runtime.js ] && { kill $serve_pid; echo "the dev server wrote runtime.js to disk"; exit 1; }
kill $serve_pid; wait $serve_pid 2>/dev/null || true
curl -s -o /dev/null http://localhost:3036/application.js && { echo "rspack serve still running"; exit 1; }
assert_match "$lazy" '^200$'
bin/rails rspack:build
[ -e public/rspack/runtime.js ] && { echo "a normal build has a runtime.js"; exit 1; }

step "rspack:doctor"
doctor=$(bin/rails rspack:doctor)
echo "$doctor"
assert_match "$doctor" 'Entry points: application, admin, print'

step "assets:precompile (production)"
export RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1
# A build starts from an empty public/rspack: stale files (also in
# subdirectories) and a development build's files (source maps) are gone.
development_js=$(built application js)
mkdir -p public/rspack/old
echo 'stale' > public/rspack/old/chart-0000.js
echo 'stale' > public/rspack/lazy-0000.js
precompile=$(bin/rails assets:precompile 2>&1) || { echo "$precompile"; exit 1; }
echo "$precompile"
files=$(ls public/rspack)
assert_match "$files" '^application-[0-9a-f]+\.js$'
assert_match "$files" '^application-[0-9a-f]+\.css$'
assert_match "$files" '^admin-[0-9a-f]+\.js$'
app_js=$(built application js)
app_css=$(built application css)
[ -e "$development_js" ] && { echo "a production build kept the development build's files"; exit 1; }
[ -e public/rspack/lazy-0000.js ] || [ -e public/rspack/old ] && { echo "stale files left in public/rspack"; exit 1; }
grep -q 'admin-entry' "$(built admin js)" || { echo "admin entry missing from bundle"; exit 1; }
hero=$(ls public/rspack | grep -E '^hero-[0-9a-f]+\.png$') || { echo "hero image not in public/rspack"; exit 1; }
font=$(ls public/rspack | grep -E '^brand-[0-9a-f]+\.woff2$') || { echo "font not in public/rspack"; exit 1; }
grep -q "$hero" "$app_css" || { echo "CSS does not point at $hero"; exit 1; }
grep -q "$font" "$app_css" || { echo "CSS does not point at $font"; exit 1; }
grep -Eq 'url\("?/icon\.png"?\)' "$app_css" || { echo "url(/icon.png) changed in production"; exit 1; }
grep -Eq 'url\("?/logo\.svg#mark"?\)' "$app_css" || { echo "url(/logo.svg) changed in production"; exit 1; }
grep -q "$hero" "$app_js" || { echo "JS image import missing"; exit 1; }
grep -lq 'postMessage' public/rspack/*.js || { echo "worker chunk missing"; exit 1; }
grep -lq 'lazy-chunk' public/rspack/*.js || { echo "lazy chunk missing"; exit 1; }
ls public/rspack | grep -q '\.map$' && { echo "source maps in public/rspack"; exit 1; }
ls public/rspack | grep -Eq '^runtime' && { echo "runtime in a production build"; exit 1; }

step "Helpers in production"
# integrity: true hashes the files Rails serves.
sri=$(bin/rails runner 'puts ApplicationController.renderer.new(https: true).render(inline: %(<%= rspack_javascript_tag "application", integrity: true %><%= rspack_stylesheet_tag "application", integrity: true %>))')
[ "$(grep -o 'integrity="sha[0-9]*-' <<<"$sri" | wc -l | tr -d ' ')" = 2 ] || { echo "expected 2 integrity attributes: $sri"; exit 1; }
for tag in $(grep -oE '(src|href)="/rspack/[^"]+" [^>]*integrity="sha[0-9]+-[^"]+"' <<<"$sri" | tr ' ' '|'); do
  file=$(sed -E 's/^(src|href)="([^"]+)".*/\2/' <<<"$tag")
  expected=$(sed -E 's/.*integrity="([^"]+)".*/\1/' <<<"$tag")
  algorithm=${expected%%-*}
  actual="$algorithm-$(openssl dgst "-$algorithm" -binary "public$file" | openssl base64 -A)"
  [ "$actual" = "$expected" ] || { echo "integrity of $file is $expected, the file hashes to $actual"; exit 1; }
done
html=$(bin/rails runner \
  'puts ApplicationController.render(inline: %(<%= rspack_javascript_tag "application", "admin" %><%= rspack_stylesheet_tag "application", "print" %>))')
assert_match "$html" 'src="/rspack/application-[0-9a-f]+\.js"'
assert_match "$html" 'src="/rspack/admin-[0-9a-f]+\.js"'
assert_match "$html" 'href="/rspack/application-[0-9a-f]+\.css"'
assert_match "$html" 'href="/rspack/print-[0-9a-f]+\.css"'
grep -q 'runtime' <<<"$html" && { echo "production links a runtime"; exit 1; }
# admin imports no CSS: the manifest lists none, so no link to a missing file.
none=$(bin/rails runner 'puts ApplicationController.render(inline: %(<%= rspack_stylesheet_tag "admin" %>))')
[ -z "$none" ] || { echo "linked CSS for an entry without any: $none"; exit 1; }
# A file in app/javascript/images, for a view.
img=$(bin/rails runner 'puts ApplicationController.render(inline: %(<%= rspack_image_tag "dot.svg", alt: "dot" %>))')
assert_match "$img" '<img src="/rspack/dot-[0-9a-f]+\.svg" alt="dot">'
assert_file "public/rspack/$(sed -E 's|.*src="/rspack/([^"]+)".*|\1|' <<<"$img")"

step "Rails serves public/rspack with a far-future cache header"
served=$(bin/rails runner '
  app = Rack::MockRequest.new(Rails.application)
  get = ->(path) { app.get(path, "HTTP_HOST" => "localhost", "HTTPS" => "on") }
  file = Dir.children("public/rspack").grep(/\Aapplication-.*\.js\z/).first
  response = get.("/rspack/#{file}")
  puts response.status, response.headers["cache-control"], response.body == File.read("public/rspack/#{file}")
  puts "manifest: #{get.("/rspack/.rspack-manifest.json").headers["cache-control"]}"' 2>&1)
assert_match "$served" '^200$'
assert_match "$served" 'public, max-age=31536000, immutable'
assert_match "$served" '^true$'
grep -q '^manifest: .*immutable' <<<"$served" && { echo "the manifest, which changes with every build, is served as immutable"; exit 1; }

step "assets:clobber"
bin/rails assets:clobber
[ -e public/rspack ] && { echo "assets:clobber left public/rspack"; exit 1; }

step "OK"
