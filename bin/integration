#!/usr/bin/env bash
# End-to-end check: generate a new Rails app, install this gem from the
# working tree and run every installer, a build, the doctor and a
# production precompile.
#
#   bin/integration            # uses the default `rails` on PATH
#   bin/integration "~> 7.2.0" # installs/uses a matching Rails version
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REQUIREMENT="${1:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"

step() { printf '\n==> %s\n' "$*"; }
assert_file() { [ -f "$1" ] || { echo "Expected file $1"; exit 1; }; }
assert_match() { grep -Eq "$2" <<<"$1" || { echo "Expected output to match $2, got:"; echo "$1"; exit 1; }; }

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

step "Generating app with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
"${rails_cmd[@]}" new app --quiet --skip-javascript --skip-bundle --skip-git --skip-test --skip-system-test \
  --skip-active-record --skip-docker --skip-ci --skip-rubocop --skip-brakeman
cd app
echo "gem \"rspack_rails\", path: \"$GEM_ROOT\"" >> Gemfile
bundle install --quiet

step "rspack:install"
bin/rails rspack:install
step "rspack:install:stimulus"
bin/rails rspack:install:stimulus
step "rspack:install:typescript"
bin/rails rspack:install:typescript

step "Adding CSS with images and a font, and a TypeScript controller"
mkdir -p app/javascript/images app/javascript/fonts
# A >8 KB image is emitted as a file, a tiny one is inlined as a data URI.
head -c 20000 /dev/urandom > app/javascript/images/hero.png
printf '<svg xmlns="http://www.w3.org/2000/svg"/>' > app/javascript/images/dot.svg
head -c 12000 /dev/urandom > app/javascript/fonts/brand.woff2
cat > app/javascript/application.css <<'CSS'
@font-face { font-family: Brand; src: url("./fonts/brand.woff2") format("woff2"); }
body { color: rebeccapurple; font-family: Brand; background: url("./images/hero.png"); }
.dot { background: url("./images/dot.svg"); }
CSS
echo 'import "./application.css"' >> app/javascript/application.js
echo 'import heroUrl from "./images/hero.png"; window.heroUrl = heroUrl' >> app/javascript/application.js
# A lazy chunk (*.digested.js) matches both rspack:clobber patterns.
echo 'export default "lazy-chunk"' > app/javascript/lazy.js
printf 'self.onmessage = (e) => self.postMessage(e.data * 2)\n' > app/javascript/worker.js
echo 'window.rspackWorker = new Worker(new URL("./worker.js", import.meta.url))' >> app/javascript/application.js
echo 'import("./lazy").then((m) => console.log(m.default))' >> app/javascript/application.js
cat > app/javascript/controllers/typed_controller.ts <<'TS'
import { Controller } from "@hotwired/stimulus"

export default class extends Controller<HTMLElement> {
  connect(): void {
    this.element.dataset.typed = "yes"
  }
}
TS

step "rspack:install:tailwind"
bin/rails rspack:install:tailwind
grep -q '@import "tailwindcss"' app/javascript/application.css || { echo "tailwind import missing"; exit 1; }
grep -q 'rspack_stylesheet_tag "application"' app/views/layouts/application.html.erb || { echo "stylesheet tag missing"; exit 1; }
mkdir -p app/views/pages
echo '<p class="text-fuchsia-700 tracking-widest">hi</p>' > app/views/pages/home.html.erb

step "Adding an admin entry point"
mkdir -p app/javascript/entrypoints
cat > app/javascript/entrypoints/admin.ts <<'TS'
const area: string = "admin-entry"
console.log(area)
TS

step "rspack:install:sass"
bin/rails rspack:install:sass
assert_file app/javascript/application.scss
# In app/javascript: on Sprockets (Rails 7.2), .scss under app/assets/stylesheets needs sassc.
mkdir -p app/javascript/stylesheets
printf '$gap: 13px;\n' > app/javascript/stylesheets/_spacing.scss
{ printf '@use "stylesheets/spacing";\n'; cat app/javascript/application.scss; printf '.sassy { .inner { margin: spacing.$gap; } }\n'; } > tmp/application.scss
mv tmp/application.scss app/javascript/application.scss

step "rspack:install:react"
bin/rails rspack:install:react
assert_file app/javascript/components/mount.js
assert_file app/javascript/components/Hello.tsx # TypeScript is set up, so the .tsx sample
grep -q '"jsx": "react-jsx"' tsconfig.json || { echo "tsconfig jsx missing"; exit 1; }
mkdir -p app/javascript/components/admin
cat > app/javascript/components/admin/Badge.tsx <<'TSX'
export default function Badge({ label }: { label: string }) {
  return <strong>{`badge:${label}`}</strong>
}
TSX

step "typecheck"
npm run typecheck

step "rspack:build"
bin/rails rspack:build
assert_file app/assets/builds/application.js
assert_file app/assets/builds/application.bundle.css
assert_file app/assets/builds/admin.js
assert_file app/assets/builds/application.js.map
ls app/assets/builds | grep -Eq '^hero-[0-9a-f]+\.digested\.png$' || { echo "hero image not emitted"; exit 1; }
grep -q 'data:image/svg' app/assets/builds/application.bundle.css || { echo "small image not inlined"; exit 1; }
[ -d node_modules/.cache/rspack ] || { echo "persistent cache missing"; exit 1; }
grep -q 'Hello, ' app/assets/builds/application.js || { echo "Hello component missing"; exit 1; }
grep -q 'badge:' app/assets/builds/application.js || { echo "nested component missing"; exit 1; }
grep -q '.sassy .inner' app/assets/builds/application.bundle.css || { echo "Sass not compiled"; exit 1; }
grep -q '13px' app/assets/builds/application.bundle.css || { echo "Sass partial not resolved"; exit 1; }
grep -q 'text-fuchsia-700' app/assets/builds/application.bundle.css || { echo "tailwind utility not generated"; exit 1; }
find app/assets/builds -name '*hot-update*' | grep -q . && { echo "hot-update files in builds"; exit 1; }

step "rspack serve (lazy compilation reaches the dev server)"
node_modules/.bin/rspack serve > tmp/rspack-serve.log 2>&1 & # not npx: $! must be rspack itself
serve_pid=$!
for _ in $(seq 1 60); do curl -s -o /dev/null http://localhost:3036/application.js && break; sleep 0.5; done
code=$(curl -s -o /dev/null -w '%{http_code}' -X POST http://localhost:3036/_rspack/lazy/trigger -d '')
grep -lq 'localhost%3A3036%2F_rspack%2Flazy%2Ftrigger' app/assets/builds/*lazy-compilation-proxy*.js ||
  { kill $serve_pid; echo "lazy compilation does not call the dev server"; exit 1; }
# Rails serves the dev server's files same-origin under /rspack/ (needed for Web Workers).
proxied=$(bin/rails runner '
  response = Rack::MockRequest.new(Rails.application).get("/rspack/application.js", "HTTP_HOST" => "localhost")
  puts response.status, response.body.include?("worker")' 2>&1) || { kill $serve_pid; echo "$proxied"; exit 1; }
assert_match "$proxied" '^200$'
kill $serve_pid; wait $serve_pid 2>/dev/null || true
curl -s -o /dev/null http://localhost:3036/application.js && { echo "rspack serve still running"; exit 1; }
[ "$code" = 200 ] || { echo "lazy compilation endpoint returned $code"; exit 1; }
bin/rails rspack:build # replace the dev server's output

step "rspack:analyze"
before=$(ls app/assets/builds)
analyze=$(bin/rails rspack:analyze)
echo "$analyze"
assert_match "$analyze" 'Rsdoctor report: .*tmp/rsdoctor/rsdoctor-report\.html'
assert_file tmp/rsdoctor/rsdoctor-report.html
assert_file tmp/rsdoctor/build/application.js
[ "$(ls app/assets/builds)" = "$before" ] || { echo "rspack:analyze changed app/assets/builds"; exit 1; }

step "rspack:doctor"
doctor=$(bin/rails rspack:doctor)
echo "$doctor"
assert_match "$doctor" 'Entry points: application, admin'

step "assets:precompile (production)"
export RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1
# Drop the development build (and its source maps), as a fresh deploy would.
bin/rails assets:clobber
assert_match "$(ls app/assets/builds)" '^$'
precompile=$(bin/rails assets:precompile 2>&1) || { echo "$precompile"; exit 1; }
echo "$precompile"
grep -q 'Unable to resolve' <<<"$precompile" && { echo "Propshaft could not resolve a url()"; exit 1; }
assets=$(ls public/assets)
assert_match "$assets" '^application-[0-9a-f]+\.js$'
assert_match "$assets" '^application\.bundle-[0-9a-f]+\.css$'
assert_match "$assets" '^admin-[0-9a-f]+\.js$'
grep -q 'admin-entry' public/assets/admin-*.js || { echo "admin entry missing from bundle"; exit 1; }
grep -q 'typed' public/assets/application-*.js || { echo "typed controller missing from bundle"; exit 1; }
hero=$(ls public/assets | grep -E '^hero-[0-9a-f]+\.digested\.png$') || { echo "hero image not in public/assets"; exit 1; }
font=$(ls public/assets | grep -E '^brand-[0-9a-f]+\.digested\.woff2$') || { echo "font not in public/assets"; exit 1; }
grep -q "/assets/$hero" public/assets/application.bundle-*.css || { echo "CSS does not point at $hero"; exit 1; }
grep -q "/assets/$font" public/assets/application.bundle-*.css || { echo "CSS does not point at $font"; exit 1; }
grep -q "$hero" public/assets/application-*.js || { echo "JS image import missing"; exit 1; }
grep -q '.sassy .inner{margin:13px}' public/assets/application.bundle-*.css || { echo "Sass missing in production"; exit 1; }
grep -q 'tracking-widest' public/assets/application.bundle-*.css || { echo "tailwind utility missing in production"; exit 1; }
grep -q 'badge:' public/assets/application-*.js || { echo "React component missing in production"; exit 1; }
grep -q 'jsxDEV' public/assets/application-*.js && { echo "development JSX runtime in production"; exit 1; }
grep -lq 'postMessage' public/assets/*.digested.js || { echo "worker chunk missing"; exit 1; }
grep -lq 'lazy-chunk' public/assets/*.digested.js || { echo "lazy chunk missing"; exit 1; }
ls public/assets | grep -q '\.map$' && { echo "source maps in public/assets"; exit 1; }

step "Helpers in production"
html=$(bin/rails runner \
  'puts ApplicationController.render(inline: %(<%= rspack_javascript_tag "application", "admin" %><%= rspack_stylesheet_tag "application" %>))')
assert_match "$html" 'src="/assets/application-[0-9a-f]+\.js"'
assert_match "$html" 'src="/assets/admin-[0-9a-f]+\.js"'
assert_match "$html" 'href="/assets/application\.bundle-[0-9a-f]+\.css"'
react=$(bin/rails runner 'puts ApplicationController.render(inline: %(<%= react_component "admin/Badge", label: "x" %>))')
assert_match "$react" 'data-react-component="admin/Badge"'

step "OK"
