#!/usr/bin/env bash
# End-to-end check: generate a new Rails app, install this gem from the
# working tree and run every installer, a build, the doctor and a
# production precompile.
#
#   bin/integration            # uses the default `rails` on PATH
#   bin/integration "~> 7.2.0" # installs/uses a matching Rails version
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REQUIREMENT="${1:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"

step() { printf '\n==> %s\n' "$*"; }
assert_file() { [ -f "$1" ] || { echo "Expected file $1"; exit 1; }; }
assert_match() { grep -Eq "$2" <<<"$1" || { echo "Expected output to match $2, got:"; echo "$1"; exit 1; }; }

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

step "Generating app with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
"${rails_cmd[@]}" new app --quiet --skip-javascript --skip-bundle --skip-git --skip-test --skip-system-test \
  --skip-active-record --skip-docker --skip-ci --skip-rubocop --skip-brakeman
cd app
echo "gem \"rspack_rails\", path: \"$GEM_ROOT\"" >> Gemfile
bundle install --quiet

step "rspack:install"
bin/rails rspack:install
step "rspack:install:stimulus"
bin/rails rspack:install:stimulus
step "rspack:install:typescript"
bin/rails rspack:install:typescript

step "Adding CSS and a TypeScript controller"
printf 'body { color: rebeccapurple; }\n' > app/javascript/application.css
echo 'import "./application.css"' >> app/javascript/application.js
cat > app/javascript/controllers/typed_controller.ts <<'TS'
import { Controller } from "@hotwired/stimulus"

export default class extends Controller<HTMLElement> {
  connect(): void {
    this.element.dataset.typed = "yes"
  }
}
TS

step "typecheck"
npm run typecheck

step "rspack:build"
bin/rails rspack:build
assert_file app/assets/builds/application.js
assert_file app/assets/builds/application.bundle.css

step "rspack:doctor"
bin/rails rspack:doctor

step "assets:precompile (production)"
export RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1
bin/rails assets:precompile
assets=$(ls public/assets)
assert_match "$assets" '^application-[0-9a-f]+\.js$'
assert_match "$assets" '^application\.bundle-[0-9a-f]+\.css$'
grep -q 'typed' public/assets/application-*.js || { echo "typed controller missing from bundle"; exit 1; }

step "Helpers in production"
html=$(bin/rails runner \
  'puts ApplicationController.render(inline: %(<%= rspack_javascript_tag "application" %><%= rspack_stylesheet_tag "application" %>))')
assert_match "$html" 'src="/assets/application-[0-9a-f]+\.js"'
assert_match "$html" 'href="/assets/application\.bundle-[0-9a-f]+\.css"'

step "OK"
