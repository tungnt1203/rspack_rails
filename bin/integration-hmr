#!/usr/bin/env bash
# End-to-end check of hot module replacement in a real browser. Generates a
# Rails app with a plain JavaScript counter, builds it once (as
# rspack:build does before tests), then runs `rails server` and `rspack serve`
# and drives Chromium with Playwright (spec/integration/hmr_check.mjs): edits
# to a module, CSS and a lazy chunk must apply without a reload, a view reloads the page.
#
#   bin/integration-hmr
#   bin/integration-hmr "~> 8.1.0"
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REQUIREMENT="${1:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"
PLAYWRIGHT_VERSION="1.65.0"
# Not 3000/3036, so a dev server already running on this machine does not clash.
RAILS_PORT="${RAILS_PORT:-3100}"
export RSPACK_DEV_SERVER_PORT="${RSPACK_DEV_SERVER_PORT:-3136}"
# As in a container: the dev server listens on every interface, and the browser
# reaches its HMR websocket at another address, given by the public URL.
export RSPACK_DEV_SERVER_HOST=0.0.0.0
export RSPACK_DEV_SERVER_PUBLIC_URL="http://127.0.0.1:$RSPACK_DEV_SERVER_PORT"

step() { printf '\n==> %s\n' "$*"; }

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

step "Generating app with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
"${rails_cmd[@]}" new app --quiet --skip-javascript --skip-bundle --skip-git --skip-test --skip-system-test \
  --skip-active-record --skip-docker --skip-ci --skip-rubocop --skip-brakeman
cd app
echo "gem \"rspack_rails\", path: \"$GEM_ROOT\"" >> Gemfile
bundle install --quiet

step "Installing rspack"
bin/rails rspack:install

step "A page with a counter"
cat > config/routes.rb <<'RUBY'
Rails.application.routes.draw do
  root "pages#home"
end
RUBY
printf 'class PagesController < ApplicationController\n  def home; end\nend\n' > app/controllers/pages_controller.rb
mkdir -p app/views/pages
cat > app/views/pages/home.html.erb <<'ERB'
<button id="increment">+1</button>
<span id="count"></span>
<p class="probe">probe</p>
<button id="load-lazy" onclick="loadLazy()">load</button>
<p id="lazy"></p>
ERB
echo '.probe { color: black; }' > app/javascript/application.css
echo 'export const label = "click"' > app/javascript/label.js
# The counter keeps its state when label.js is edited: the page accepts that module's updates.
cat > app/javascript/application.js <<'JS'
import "./application.css"
import { label } from "./label"

const output = document.querySelector("#count")
let count = 0
const show = () => { output.textContent = `${count} ${label}${count === 1 ? "" : "s"}` }
document.querySelector("#increment").addEventListener("click", () => { count++; show() })
show()
import.meta.webpackHot?.accept("./label", show) // live binding: `label` is the new value

// A dynamic import(): under rspack serve it is compiled when the page first asks for it.
window.loadLazy = () => import("./lazy").then((m) => { document.querySelector("#lazy").textContent = m.message })
JS
echo 'export const message = "lazy loaded"' > app/javascript/lazy.js

step "rspack:build first (fills the persistent cache, as before tests or precompile)"
bin/rails rspack:build

step "Installing Playwright"
npm install --silent --no-save "playwright@$PLAYWRIGHT_VERSION"
if [ -n "${CI:-}" ]; then
  npx playwright install --with-deps chromium
else
  npx playwright install chromium
fi

step "Starting rails server and rspack serve"
bin/rails server -p "$RAILS_PORT" > tmp/rails-server.log 2>&1 &
rails_pid=$!
node_modules/.bin/rspack serve > tmp/rspack-serve.log 2>&1 &
serve_pid=$!
cleanup() { kill "$rails_pid" "$serve_pid" 2>/dev/null || true; wait "$rails_pid" "$serve_pid" 2>/dev/null || true; }
trap cleanup EXIT
for _ in $(seq 1 120); do
  curl -sf -o /dev/null "http://localhost:$RSPACK_DEV_SERVER_PORT/application.js" &&
    curl -sf -o /dev/null "http://localhost:$RAILS_PORT/" && break
  sleep 0.5
done

step "Hot updates in Chromium"
if ! node "$GEM_ROOT/spec/integration/hmr_check.mjs" "$PWD" "http://localhost:$RAILS_PORT/"; then
  echo "--- rspack serve ---"; tail -20 tmp/rspack-serve.log
  exit 1
fi

step "OK"
