#!/usr/bin/env bash
# End-to-end check of `rspack:migrate`: generate an importmap, jsbundling
# (esbuild) or importmap + tailwindcss-rails Rails app, migrate it to rspack
# (and to rspack:install:tailwind), or importmap + dartsass-rails, then build,
# run the doctor and precompile for production.
#
#   bin/integration-migrate importmap
#   bin/integration-migrate jsbundling "~> 8.1.0"
#   bin/integration-migrate tailwind
#   bin/integration-migrate sass
set -euo pipefail

GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODE="${1:?usage: bin/integration-migrate importmap|jsbundling|tailwind|sass [rails requirement]}"
REQUIREMENT="${2:-}"
WORK_DIR="${WORK_DIR:-$(mktemp -d)}"

step() { printf '\n==> %s\n' "$*"; }
fail() { echo "FAIL: $*"; exit 1; }
assert_match() { grep -Eq "$2" <<<"$1" || fail "expected output to match $2, got: $1"; }
assert_no_file() { [ ! -e "$1" ] || fail "$1 should have been removed"; }

rails_cmd=(rails)
if [ -n "$REQUIREMENT" ]; then
  gem list -i rails -v "$REQUIREMENT" >/dev/null || gem install rails -v "$REQUIREMENT" --no-document
  version=$(ruby -e 'puts Gem::Specification.find_all_by_name("rails", ARGV[0]).map(&:version).max' "$REQUIREMENT")
  rails_cmd=(rails "_${version}_")
fi

case "$MODE" in
  importmap) js_flag=() ;;
  jsbundling) js_flag=(-j esbuild) ;;
  tailwind) js_flag=(--css tailwind) ;;
  sass) js_flag=(--css sass) ;;
  *) fail "unknown mode $MODE" ;;
esac

step "Generating a $MODE app with $("${rails_cmd[@]}" --version) in $WORK_DIR"
cd "$WORK_DIR"
"${rails_cmd[@]}" new app --quiet ${js_flag[@]+"${js_flag[@]}"} --skip-git --skip-test --skip-system-test --skip-active-record \
  --skip-docker --skip-ci --skip-rubocop --skip-brakeman
cd app

if [ "$MODE" = jsbundling ] && [ ! -f yarn.lock ]; then
  # jsbundling's installer needs yarn; without it, add what it would have added.
  npm install --silent --save-dev esbuild
  npm install --silent @hotwired/turbo-rails @hotwired/stimulus
fi

if [ "$MODE" = importmap ] || [ "$MODE" = tailwind ]; then
  # A second layout and a second stylesheet of the app's own, as a real app has.
  cp app/views/layouts/application.html.erb app/views/layouts/admin.html.erb
  # Rails 8 links stylesheets with `:app`; Rails 7.2 (Sprockets) names "application".
  grep -q 'stylesheet_link_tag :app' app/views/layouts/admin.html.erb && app_stylesheets=1 || app_stylesheets=
  mkdir -p app/assets/stylesheets
  printf '.driver-popover { color: #123456; }\n' > app/assets/stylesheets/driver.css
fi
if [ "$MODE" = tailwind ]; then
  # A file application.css imports, which moves with it.
  printf '.font-check { letter-spacing: 0.123em; }\n' > app/assets/tailwind/fonts.css
  ruby -i -pe 'sub(/^@import "tailwindcss";$/) { "#{$&}\n@import \"./fonts.css\";" }' app/assets/tailwind/application.css
fi

echo "gem \"rspack_rails\", path: \"$GEM_ROOT\"" >> Gemfile
bundle install --quiet
printf '/log/*\n/tmp/*\n/storage/*\n/public/assets\n/node_modules\n/app/assets/builds/*\n!/app/assets/builds/.keep\n.bundle\n' > .gitignore
git init -q && git add -A && git -c user.email=ci@example.com -c user.name=ci commit -qm "before migration"

step "rspack:migrate"
bin/rails rspack:migrate

step "Checking the migration"
if [ "$MODE" != jsbundling ]; then
  assert_no_file config/importmap.rb
  assert_no_file bin/importmap
  ! grep -q importmap-rails Gemfile || fail "importmap-rails still in Gemfile"
  ! grep -q stale_when_importmap_changes app/controllers/application_controller.rb || fail "importmap call left"
else
  ! grep -q jsbundling-rails Gemfile || fail "jsbundling-rails still in Gemfile"
  ! grep -q '"esbuild"' package.json || fail "esbuild still in package.json"
fi
grep -q 'rspack_javascript_tag "application"' app/views/layouts/application.html.erb || fail "layout tag missing"
if [ "$MODE" = importmap ] || [ "$MODE" = tailwind ]; then
  grep -q 'rspack_javascript_tag "application"' app/views/layouts/admin.html.erb || fail "admin layout lost its script"
  # `stylesheet_link_tag :app` links app/assets only now (rspack's CSS is in public/rspack): left as it is.
  if [ -n "$app_stylesheets" ]; then
    grep -q 'stylesheet_link_tag :app' app/views/layouts/admin.html.erb || fail "stylesheet_link_tag :app was rewritten"
  fi
fi
grep -q 'controllers/autoload' app/javascript/application.js || fail "autoload import missing"
grep -q '^js: .* dev$' Procfile.dev || fail "Procfile.dev does not run the dev server"

if [ "$MODE" = sass ]; then
  mkdir -p app/assets/stylesheets/components
  printf '$brand: #c0ffee;\n' > app/assets/stylesheets/_variables.scss
  printf '@use "../variables" as v;\n.card { .title { color: v.$brand; } }\n' > app/assets/stylesheets/components/_card.scss
  printf '@use "variables";\n@use "components/card";\n' > app/assets/stylesheets/application.scss
  git add -A && git -c user.email=ci@example.com -c user.name=ci commit -qm "sass partials"

  step "rspack:install:sass"
  bin/rails rspack:install:sass
  ! grep -q dartsass-rails Gemfile || fail "dartsass-rails still in Gemfile"
  ! grep -q '^css:' Procfile.dev || fail "Procfile.dev still runs dartsass:watch"
  grep -q 'assets/stylesheets/application.scss' app/javascript/application.js || fail "scss import missing"
fi

if [ "$MODE" = tailwind ]; then
  step "rspack:install:tailwind"
  bin/rails rspack:install:tailwind
  assert_no_file app/assets/tailwind/application.css
  assert_no_file app/assets/builds/tailwind.css
  [ ! -e app/assets/builds/application.js ] || fail "rspack built into app/assets/builds"
  ! grep -q tailwindcss-rails Gemfile || fail "tailwindcss-rails still in Gemfile"
  ! grep -q '^css:' Procfile.dev || fail "Procfile.dev still runs tailwindcss:watch"
  grep -q '@import "tailwindcss"' app/javascript/application.css || fail "tailwind import not moved"
  grep -q '@source not "../../tmp"' app/javascript/application.css || fail "tailwind scan excludes missing"
  grep -q 'rspack_stylesheet_tag "application"' app/views/layouts/application.html.erb || fail "stylesheet tag missing"
  grep -q 'rspack_stylesheet_tag "application"' app/views/layouts/admin.html.erb || fail "admin stylesheet tag missing"
  [ -f app/javascript/fonts.css ] || fail "fonts.css did not move with application.css"
  assert_no_file app/assets/tailwind
fi

step "rspack:build"
bin/rails rspack:build

step "rspack serve after a build keeps HMR"
# The build above fills the persistent cache with modules compiled without
# HMR; the dev server must not reuse them (import.meta.webpackHot -> false).
node_modules/.bin/rspack serve > tmp/rspack-serve.log 2>&1 &
serve_pid=$!
for _ in $(seq 1 60); do curl -s -o /dev/null http://localhost:3036/application.js && break; sleep 0.5; done
curl -s -o tmp/serve-application.js http://localhost:3036/application.js
kill $serve_pid; wait $serve_pid 2>/dev/null || true
grep -q 'module.hot.accept(context.id' tmp/serve-application.js ||
  fail "Stimulus autoload has no hot accept under rspack serve after a build"
bin/rails rspack:build

step "rspack:doctor"
bin/rails rspack:doctor

step "assets:precompile (production)"
export RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1
bin/rails assets:precompile
assert_match "$(ls public/rspack)" '^application-[0-9a-f]+\.js$'
grep -q 'Hello World' public/rspack/application-*.js || fail "hello controller missing from bundle"
grep -q 'turbo' public/rspack/application-*.js || fail "turbo missing from bundle"

if [ "$MODE" = sass ]; then
  grep -q '.card .title{color:#c0ffee}' public/rspack/application-*.css || fail "Sass partials not compiled"
fi

if [ "$MODE" = tailwind ]; then
  # The generated layout uses `container mx-auto mt-28 px-5 flex`.
  grep -q 'mx-auto' public/rspack/application-*.css || fail "tailwind utilities missing"
  grep -q 'letter-spacing:.123em' public/rspack/application-*.css || fail "fonts.css not in the bundle"
  ls public/assets | grep -q '^tailwind' && fail "tailwindcss-rails output still in public/assets"
fi

step "The app boots in production"
html=$(bin/rails runner 'puts ApplicationController.render(inline: %(<%= rspack_javascript_tag "application" %>))')
assert_match "$html" 'src="/rspack/application-[0-9a-f]+\.js"'

step "OK"
