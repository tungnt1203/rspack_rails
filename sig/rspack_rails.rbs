# The public API of rspack_rails, stable from 1.0 (docs/upgrading.md, "Stability").
# 2.0 added Manifest::MissingEntry and StaticFiles.
# Other constants and methods under RspackRails (the installers, the doctor,
# the migration, the deprecator) are internal and may change in any release.
module RspackRails
  VERSION: String

  class Error < StandardError
  end

  def self.config: () -> Configuration
  def self.configure: () { (Configuration) -> void } -> void
  def self.dev_server: () -> DevServer

  class Manifest
    # Raised by the view helpers for an entry that no build lists.
    class MissingEntry < Error
    end
  end

  class Configuration
    attr_reader dev_server_host: String
    attr_reader dev_server_port: Integer
    attr_writer dev_server_enabled: bool?
    def initialize: (?Hash[String, String] env) -> void
    def dev_server_enabled: () -> bool
    def dev_server_url: () -> String
  end

  class DevServer
    def running?: () -> bool
    def url: (String | Symbol path) -> String
  end

  # Rack middleware the Railtie inserts; serves `rspack serve` under /rspack/.
  class DevServerProxy
    PREFIX: String
    def initialize: (untyped app, ?config: Configuration) -> void
    def call: (Hash[String, untyped] env) -> [Integer, Hash[String, String], Array[String]]
  end

  # Rack middleware the Railtie inserts where Rails serves public/; serves
  # public/rspack under /rspack/ with a far-future Cache-Control.
  class StaticFiles
    PREFIX: String
    def initialize: (untyped app, root: Pathname | String) -> void
    def call: (Hash[String, untyped] env) -> untyped
  end

  # Included into Action View.
  module Helper
    def rspack_javascript_tag: (*String | Symbol entries, **untyped options) -> String
    def rspack_stylesheet_tag: (*String | Symbol entries, **untyped options) -> String
    def react_component: (String name, ?Hash[untyped, untyped] props, ?html: Hash[Symbol, untyped], **untyped more_props) -> String
  end
end
