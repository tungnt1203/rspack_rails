module RspackRails
  VERSION: String

  class Error < StandardError
  end

  class PackageManager
    attr_reader root: String
    attr_reader name: Symbol
    def self.detect: (?untyped root) -> PackageManager
    def initialize: (untyped root) -> void
    def install_command: () -> String
    def add_dev_command: (*String packages) -> String
    def run_command: (String script) -> String
  end
end

module RspackRails
  def self.config: () -> Configuration
  def self.configure: () { (Configuration) -> void } -> void
  def self.dev_server: () -> DevServer

  class Configuration
    attr_accessor dev_server_host: String
    attr_accessor dev_server_port: Integer
    attr_writer dev_server_enabled: bool?
    def initialize: (?Hash[String, String] env) -> void
    def dev_server_enabled: () -> bool
    def dev_server_url: () -> String
  end

  class DevServer
    def initialize: (Configuration config, ?check_interval: Float | Integer) -> void
    def running?: () -> bool
    def url: (String | Symbol path) -> String
  end
end
